{
	"name": "DF_Populate_DataMart_Dim",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_ASQL_tMovies",
						"type": "DatasetReference"
					},
					"name": "SRCtMovies"
				},
				{
					"dataset": {
						"referenceName": "DS_ASQL_tMovieStatus",
						"type": "DatasetReference"
					},
					"name": "SRCtMovieStatus"
				},
				{
					"dataset": {
						"referenceName": "DS_ASQL_tOnlineService",
						"type": "DatasetReference"
					},
					"name": "SRCtOnlineService"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_ASQL_DimMovie",
						"type": "DatasetReference"
					},
					"name": "SinkDimMovie"
				},
				{
					"dataset": {
						"referenceName": "DS_ASQL_DimOnlineService",
						"type": "DatasetReference"
					},
					"name": "SinkDimOnlineService"
				}
			],
			"transformations": [
				{
					"name": "JOINtMovieStatus"
				},
				{
					"name": "SelectColumnsMS"
				},
				{
					"name": "AddDatesMS"
				},
				{
					"name": "SelectColumnsOS"
				},
				{
					"name": "AddDatesOS"
				}
			],
			"scriptLines": [
				"source(output(",
				"          MovieId as integer,",
				"          MovieIdNK as integer,",
				"          Budget as integer,",
				"          HomepagePath as string,",
				"          Title as string,",
				"          OriginalTitle as string,",
				"          ReleaseDate as date,",
				"          Revenue as long,",
				"          Runtime as integer,",
				"          MovieStatusId as integer,",
				"          AvgVote as decimal(3,1),",
				"          CreatedDate as timestamp,",
				"          ModifiedDate as timestamp,",
				"          SrcFileName as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCtMovies",
				"source(output(",
				"          MovieStatusId as integer,",
				"          MovieStatusName as string,",
				"          CreatedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCtMovieStatus",
				"source(output(",
				"          ServiceId as integer,",
				"          ServiceCode as string,",
				"          ServiceName as string,",
				"          CreatedDate as timestamp,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCtOnlineService",
				"SRCtMovies, SRCtMovieStatus join(SRCtMovies@MovieStatusId == SRCtMovieStatus@MovieStatusId,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JOINtMovieStatus",
				"JOINtMovieStatus select(mapColumn(",
				"          MovieIdNK,",
				"          Title,",
				"          ReleaseDate,",
				"          Runtime,",
				"          MovieStatus = MovieStatusName",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectColumnsMS",
				"SelectColumnsMS derive(CreatedDate = currentDate('UTC'),",
				"          ModifiedDate = currentDate('UTC')) ~> AddDatesMS",
				"SRCtOnlineService select(mapColumn(",
				"          ServiceCode,",
				"          ServiceName",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectColumnsOS",
				"SelectColumnsOS derive(CreatedDate = currentDate('UTC'),",
				"          ModifiedDate = currentDate('UTC')) ~> AddDatesOS",
				"AddDatesMS sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          MovieKey as integer,",
				"          MovieIdNK as integer,",
				"          Title as string,",
				"          ReleaseDate as date,",
				"          Runtime as integer,",
				"          MovieStatus as string,",
				"          CreatedDate as timestamp,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     preSQLs:['truncate table [dbo].[DimMovie];'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SinkDimMovie",
				"AddDatesOS sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ServiceKey as integer,",
				"          ServiceCode as string,",
				"          ServiceName as string,",
				"          CreatedDate as timestamp,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     preSQLs:['truncate table [dbo].[DimOnlineService];'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SinkDimOnlineService"
			]
		}
	}
}