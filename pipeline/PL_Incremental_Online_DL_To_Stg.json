							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_LoadOnlinePurchase]"
				},
				"linkedServiceName": {
					"referenceName": "LS_ASQL_Movies",
					"type": "LinkedServiceReference"
				}
			}
		],
		"folder": {
			"name": "Incremental Online"
		},
		"annotations": [],
		"lastPublishTime": "2026-04-14T09:07:08Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
