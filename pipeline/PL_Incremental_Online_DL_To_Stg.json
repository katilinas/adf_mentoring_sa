				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_LoadOnlineService]"
				},
				"linkedServiceName": {
					"referenceName": "LS_ASQL_Movies",
					"type": "LinkedServiceReference"
				}
			},
